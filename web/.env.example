# Copy to web/.env.local for local dev. In Vercel, set these under Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — safe in the browser; RLS does the protecting
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — server-only, never NEXT_PUBLIC_; used by admin routes and the XLSX export
SUPABASE_SECRET_KEY=
