# Copy to pipeline/.env on each machine and fill in. Never commit the filled file.
# The same names are used as GitHub Actions secrets for the monthly refresh.

# EIA Open Data API v2 — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ERCOT Public API — https://apiexplorer.ercot.com (username/password are your API Explorer login;
# subscription key is the "Primary key" on your Profile page after subscribing to the Public API product)
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_API_SUBSCRIPTION_KEY=

# NLR (formerly NREL) Developer Network — NSRDB — https://developer.nlr.gov/signup/
NLR_API_KEY=

# Supabase — Project Settings → API Keys. Use the Secret key (sb_secret_…), server-only.
# (Older projects: the legacy service_role JWT also works here.)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional
SLACK_WEBHOOK_URL=
